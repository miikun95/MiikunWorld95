{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "MiikunLog95",
  "short_name": "M.K.Log95",
  "description": "",
  "id": "https://blog.miikun95.net/",
  "lang": "ja",
  "dir": "ltr",
  "orientation": "any",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "theme_color": "#CCCCCC",
  "background_color": "#CCCCCC",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/apple-touch-icon.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "splash_screen": {
    "src": "/apple-touch-icon.png",
    "sizes": "512x512",
    "background_color": "#FFFFFF"
  }
}
